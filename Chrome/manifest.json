{
  "manifest_version": 3,
  "name": "Quick OTJ Logger for Multiverse.io",
  "version": "1.0",
  "description": "Log off-the-job time to Multiverse.",
  "permissions": [
    "cookies"
  ],
  "host_permissions": [
    "https://otj.multiverse.io/*"
  ],
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  }
}